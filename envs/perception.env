# DISPLAY / GPU
DISPLAY=${DISPLAY:-:0}
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
XAUTH=/tmp/.docker.xauth
#LIBGL_ALWAYS_SOFTWARE=1

# Tested image overrides for the perception stack.
# Leave unset to use the compose defaults.
# AZURE_KINECT_IMAGE=ghcr.io/haru-project/strawberry-ros-azure-kinect:feature-asr-improve
# SKELETONS_IMAGE=ghcr.io/haru-project/strawberry-ros-skeletons:feature-asr-improve
# FACES_IMAGE=ghcr.io/haru-project/strawberry-ros-faces-module:feature-asr-improve
# HARU_BELIEF_IMAGE=ghcr.io/haru-project/haru-belief:feature-asr-improve
# HARU_VIZ_IMAGE=ghcr.io/haru-project/haru-viz:feature-asr-improve

# ROS
ROS_DOMAIN_ID=0
HARU_ROBOT_ROS_DOMAIN_ID=0
HARU_PERCEPTION_ROS_DOMAIN_ID=200
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
HARU_TOPIC_PREFIX=

# ************ #
# AZURE KINECT CAMERA
# ************ #

# Leave depth mode unset so the Azure Kinect driver keeps its sensor/profile default
# from `strawberry_azure_kinect_params.yml` (`NFOV_2X2BINNED` today).
# Uncomment only when you intentionally want to override that default.
# AZURE_KINECT_DEPTH_MODE=WFOV_2X2BINNED

# Camera position
AZURE_KINECT_POS_X=-0.3
AZURE_KINECT_POS_Y=0.0
AZURE_KINECT_POS_Z=1.3
AZURE_KINECT_ATT_ROLL=0.0
AZURE_KINECT_ATT_PITCH=0.0
AZURE_KINECT_ATT_YAW=0.0
AZURE_KINECT_AUDIO_ENABLED=false
AZURE_KINECT_PUBLISH_AUDIO_OPUS=false


# **************** #
# SKELETONS MODULE
# **************** #
SKELETONS_IMGSZ=384
SKELETONS_MAX_DET=5
SKELETONS_INFERENCE_REUSE_ENABLED=true
SKELETONS_INFERENCE_REUSE_SIMILARITY_CHECK=true
SKELETONS_INFERENCE_REUSE_MAX_AGE_SEC=0.10
SKELETONS_INFERENCE_REUSE_MAX_CONSECUTIVE=2
SKELETONS_INFERENCE_REUSE_DEBUG_LOGS=false


# ************ #
# FACES MODULE
# ************ #
TF_CPP_MIN_LOG_LEVEL=3
GLOG_minloglevel=2
ORT_LOG_SEVERITY_LEVEL=3

# =============================================================================
# MODULE-WIDE SETTINGS
# =============================================================================
# Data root - compose sets this to the persistent bind mount target so
# runtime config and recognition artifacts survive container recreation.
# FACES_DATA_ROOT=/ros/strawberry_ros_faces_module
# Compose sets these deployment-specific values for same-host Kinect deployment.
# FACES_NAMESPACE=/perception/proc
# FACES_RGB_TOPIC=/perception/sensor/camera/kinect/cam_1/rgb
# FACES_CAMERA_INFO_TOPIC=/perception/sensor/camera/kinect/cam_1/camera_info
# FACES_RESPAWN=true
# FACES_LOG_LEVEL=INFO

# =============================================================================
# FACES SOURCE DEFAULTS
# =============================================================================
# FACES_DEV_AUTOSTART=true
# FACES_USE_FFMPEG_DECODE_BRIDGE=false
# FACES_IMAGE_TOPIC=
# FACES_FFMPEG_BASE_TOPIC=/perception/sensor/camera/kinect/cam_1/rgb
# FACES_FFMPEG_DECODED_TOPIC=/perception/proc/rgb/image_raw_ffmpeg_decoded
# FACES_FFMPEG_IMAGE_TOPIC=
# FACES_RGB_FALLBACK_TOPIC=
# FACES_SENSOR_QOS_RELIABILITY=best_effort
# FACES_SENSOR_QOS_DEPTH=1
# FACES_OUTPUT_TOPIC=faces
# FACES_USE_SIM_TIME=false
# FACES_SOURCE_LIVENESS_TIMEOUT_SEC=2.0
# FACES_SOURCE_CHECK_PERIOD_SEC=0.0
# FACES_LOAD_PERSISTED_RUNTIME_CONFIG=true
# FACES_COMPRESSED_DECODE_BACKEND=auto
# FACES_FRAME_WORKER_THREADS=1
# FACES_AUX_CLASSIFIER_THREADS=1
# FACES_TRACKER_METRICS_ENABLED=false

# =============================================================================
# INSIGHTFACE DETECTION
# =============================================================================
# FACES_INSIGHTFACE_PACK_NAME=buffalo_l
# FACES_INSIGHTFACE_DET_SIZE=[640, 640]
# FACES_INSIGHTFACE_MAX_SIZE=960
# FACES_DETECTION_THRESHOLD=0.35
# FACES_MAX_NUMBER_FACES=0
# FACES_DETECTOR_PRECOMPUTE_EMBEDDINGS=false

# Low-GPU deployment overrides. Keep buffalo_l for recognition continuity while
# lowering detector input cost.
FACES_INSIGHTFACE_PACK_NAME=buffalo_l
FACES_INSIGHTFACE_DET_SIZE=[320, 320]
FACES_INSIGHTFACE_MAX_SIZE=640

# =============================================================================
# TRACKER / ID RECOGNITION
# =============================================================================
# FACES_INITIAL_ID_TRACKED=1
# FACES_TIMEOUT_TRACKER=5.0
# FACES_EMBEDDING_THRESHOLD=0.1
# FACES_EMBEDDING_WEIGHT=0.2
# FACES_FACE_TRACKER_DEVICE=auto
# FACES_ENABLE_DEBUG_TRACKER=true
# FACES_RECOGNITION_ENABLED=true
# FACES_RECOGNITION_THRESHOLD=0.75
# FACES_RECOGNITION_DEVICE=auto
# FACES_ENABLE_POSE_GATING=true
# FACES_NOVELTY_SIMILARITY_GUARD=0.35
# FACES_DUPLICATE_REUSE_SIMILARITY=0.48
# FACES_NOVELTY_BLOCK_TIMEOUT=30.0
# FACES_MEMORY_FORCE_REUSE_THRESHOLD=0.45
# FACES_PENDING_EMBEDDING_REUSE_THRESHOLD=0.55
# FACES_REUSE_POSITION_THRESHOLD=0.40
# FACES_CONFIRMATION_FRAMES=3
# FACES_ENROLLMENT_MIN_SAMPLES=64
# FACES_PENDING_MIN_SAMPLES=8
# FACES_COMMIT_MIN_SAMPLES=16
# FACES_COMMIT_MIN_DURATION=1.0
# FACES_ENROLLMENT_START_MIN_OBSERVATIONS=3
# FACES_ENROLLMENT_START_MIN_DURATION=0.10
# FACES_PENDING_RESTART_COOLDOWN=1.0
# FACES_WIPE_TRACKER_STORAGE_ON_START=false

# =============================================================================
# TRACKER REUSE / THROTTLING
# =============================================================================
# Source defaults currently keep tracker/inference reuse disabled.
# FACES_TRACKER_REUSE_ENABLED=false
# FACES_TRACKER_REUSE_PUBLISH_RATE_HZ=30.0
# FACES_TRACKER_REUSE_MAX_AGE_SEC=0.0
# FACES_TRACKER_REUSE_SIMILARITY_CHECK=true
# FACES_TRACKER_REUSE_MAX_CONSECUTIVE=0
# FACES_TRACKER_REUSE_DURING_PENDING_ENROLLMENT=false
# FACES_TRACKER_REUSE_PENDING_MAX_AGE_SEC=-1.0
# FACES_TRACKER_REUSE_PENDING_MAX_CONSECUTIVE=-1
# FACES_FRESH_DETECTION_MAX_AGE_SEC=0.0
# FACES_TRACKER_REUSE_DEBUG_LOGS=false

# Low-GPU deployment overrides. Frame-level reuse skips detector/tracker work on
# stable adjacent frames; the independent timer republisher is disabled.
FACES_TRACKER_REUSE_ENABLED=true
FACES_TRACKER_REUSE_PUBLISH_RATE_HZ=0.0
FACES_TRACKER_REUSE_MAX_AGE_SEC=0.10
FACES_TRACKER_REUSE_SIMILARITY_CHECK=true
FACES_TRACKER_REUSE_MAX_CONSECUTIVE=2
FACES_TRACKER_REUSE_DURING_PENDING_ENROLLMENT=false
FACES_TRACKER_REUSE_PENDING_MAX_AGE_SEC=-1.0
FACES_TRACKER_REUSE_PENDING_MAX_CONSECUTIVE=-1
FACES_FRESH_DETECTION_MAX_AGE_SEC=0.10
FACES_TRACKER_REUSE_DEBUG_LOGS=false

# =============================================================================
# DEPRECATED AUXILIARY CLASSIFIERS
# =============================================================================
# FACES_ENABLE_FACES_GENDER=false
# FACES_ENABLE_FACES_EMOTION=false
# FACES_AUX_REFRESH_MAX_AGE_SEC=0.9


# viz service defaults
HARU_VIZ_IMAGE=ghcr.io/haru-project/haru-viz@sha256:6c514b501c23447eb30769b8681d92d2317b2dc8690e950bae9240c4bf2ae48e
HARU_VIZ_REPO_ROOT=/workspace/haru-viz
HARU_VIZ_UI_HOST=0.0.0.0
HARU_VIZ_UI_PORT=5173
HARU_ROSBRIDGE_PORT=9190
HARU_ROSBRIDGE_RGB_PORT=9191
HARU_ROSBRIDGE_DEPTH_PORT=9192
HARU_ROSBRIDGE_DEPTH_TO_RGB_PORT=9193
HARU_ROSBRIDGE_MAX_MESSAGE_SIZE=8388608



# ======================
# Monitor launcher args
# ======================

# Absolute Python path for monitor venv used by compose.
# WARNING: Changing this may break GPU/NVML detection if the nodes fall back
# to system Python without required packages. Keep in sync with image layout.
# commented out to use default
#MON_VENV_PATH=/home/haru/haru_ws/install/strawberry_resource_monitor/share/strawberry_resource_monitor/venv_monitor/bin/python3

MON_RESPAWN=true
MON_TOPIC_PREFIX=/perception/status/consumption
MON_LOG_LEVEL=INFO

# Feature toggles
MON_CPU_ENABLED=true
MON_MEMORY_ENABLED=true
MON_GPU_ENABLED=true
MON_SPIKES_ENABLED=true

# Rates and windows
MON_PUBLISH_RATE_HZ=5.0
MON_WINDOW_SEC=1.0

# Advanced toggles
MON_ENABLE_GPU_PROCESSES=false
MON_ENABLE_POWER_METRICS=true

# Spike detector thresholds
MON_CPU_TOTAL_PERCENT_THRESHOLD=85.0
MON_CPU_CORE_PERCENT_THRESHOLD=95.0
MON_MEM_USED_PERCENT_THRESHOLD=90.0
MON_GPU_UTIL_PERCENT_THRESHOLD=90.0
MON_GPU_MEM_UTIL_PERCENT_THRESHOLD=90.0
MON_SPIKE_MIN_DURATION_SEC=0.5
MON_SPIKE_CLEAR_HYSTERESIS_PERCENT=5.0

# ==========================
# Stresstest launcher args
# ==========================

# Absolute Python path for stresstest venv used by compose.
# WARNING: Changing this may break GPU backends resolution for stress tests.
# Keep in sync with image layout.
#STRESS_VENV_PATH=/home/haru/haru_ws/install/strawberry_resource_monitor/share/strawberry_resource_monitor/venv_stresstest/bin/python3

STRESS_DURATION=30.0

# Which stresstest processes to run
STRESS_RUN_CPU=false
STRESS_RUN_MEMORY=false
STRESS_RUN_GPU=true

# CPU stress params
STRESS_CPU_WORKERS=2
STRESS_CPU_DUTY=1.0

# Memory stress params
STRESS_MEM_TARGET_PERCENT=60.0
STRESS_MEM_TARGET_GB=0.0
STRESS_MEM_RAMP_SEC=5.0
STRESS_MEM_CHUNK_MB=128

# GPU stress params
STRESS_GPU_BACKEND=auto
STRESS_GPU_TARGET_PERCENT=50.0
STRESS_GPU_TARGET_GB=0.0
STRESS_GPU_CHUNK_MB=256
STRESS_GPU_DEVICE=0
