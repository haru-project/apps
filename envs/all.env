# Combined env file for docker-compose-all.yaml
# Keep in sync with envs/*.env when adding new compose-time variables.

# DISPLAY / GPU
DISPLAY=${DISPLAY:-:0}
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS (default domain for most stacks)
ROS_DOMAIN_ID=0
HARU_ROBOT_ROS_DOMAIN_ID=0
HARU_PERCEPTION_ROS_DOMAIN_ID=200
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Perception image override
FACES_IMAGE=ghcr.io/haru-project/strawberry-ros-faces-module@sha256:ff26d5988ed5db5bbee9324fb1e19f97dfceb7dd1d60ce6600beae0a0772821a

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# LLM
ACTION_ARGS_CONFIG_FILE=/shared/configs/haru_llm.yaml
LLM_SERVER_HOST_PORT=4050
LLM_SERVER_BASE_URL=http://127.0.0.1:4050/v1
BEDROCK_MANTLE_REGION=eu-central-1
VLLM_MODEL_NAME=openai/gpt-oss-20b
WEBUI_AUTH=False
OPENAI_API_BASE_URL=http://server:4000/v1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard
HARU_AGENT_MODEL_ID=haru:canonical
HARU_JP_AGENT_MODEL_ID=haru:canonical
GOAL_AGENT_MODEL_ID=haru:canonical
GOAL_INFERENCE_AGENT_MODEL_ID=haru:canonical
GAZING_AGENT_MODEL_ID=haru:canonical
TTS_AGENT_MODEL_ID=haru:canonical
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=haru:canonical
SUMMARY_AGENT_MODEL_ID=haru:canonical
SYNCED_ROUTINES_AGENT_MODEL_ID=haru:canonical
MICRO_ROUTINES_AGENT_MODEL_ID=haru:canonical

# SPEECH
HARU_SPEECH_BASE_IMAGE=ghcr.io/haru-project/haru-speech-base@sha256:152d851f5e9899f7ebe277bb98f732cab575d37323352619b013ce6cb7b335f4
HARU_SPEECH_AUDIO_IMAGE=ghcr.io/haru-project/haru-speech-audio@sha256:15c38d549b6a31ee1c8f363267b155e21a147033dbe1ae329828af0fcbdd02d2
HARU_SPEECH_RECOGNITION_IMAGE=ghcr.io/haru-project/haru-speech-recognition@sha256:28e418906774d2f816b9913dc7b5f966aa659229deac3fb705a155e7994ab9c6
HARU_SPEECH_VERIFICATION_IMAGE=ghcr.io/haru-project/haru-speech-verification@sha256:461e06a140ada45c2e14232fd52f4cddbcacb7aa7c2473addb86548871cc71c5
HARU_SPEECH_LOCALIZATION_IMAGE=ghcr.io/haru-project/haru-speech-localization@sha256:bf194c90f417d65dead83df53a771d209eec6ea93942cf56680d8ec243e031ea
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices
AUDIO_CONFIG_FILE=/shared/configs/haru_speech.yaml
BASE_CONFIG_FILE=/shared/configs/haru_speech.yaml
AUDIO_CAPTURE_MODE=multi_device
AUDIO_CAPTURE_STATE_FILE=/shared/state/haru_speech/audio_capture_state.yaml
SPEECH_RECOGNITION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/shared/configs/haru_speech.yaml

# haru-viz bridge
HARU_ROSBRIDGE_DEPTH_TO_RGB_PORT=9093

# REASONER
REACTIVE_RULES_FILE=/shared/configs/reactiveness/reactive_rules.json
WORLD_MODEL_FILE=/shared/configs/world_models/haru_model.pddl
PLANSYS2_CONFIG_FILE=/shared/configs/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/shared/configs/params/postprocessors_params.yaml
TASK_SCENARIO_FILE=episodes/20260129.json
TASK_TEST_FILE=tests/Express.json

# SIMULATOR
AUDIO_CARD=0
PULSE_SERVER=unix:/tmp/pulse/native
PULSE_SOCKET_PATH=/run/user/1000/pulse/native

# TTS
PYTHONUNBUFFERED=1
