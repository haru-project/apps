# Combined env file for docker-compose-all.yaml
# Keep in sync with envs/*.env when adding new compose-time variables.

# DISPLAY / GPU
DISPLAY=${DISPLAY:-:0}
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS (default domain for most stacks)
ROS_DOMAIN_ID=19
HARU_ROBOT_ROS_DOMAIN_ID=19
HARU_PERCEPTION_ROS_DOMAIN_ID=200
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Perception image override
FACES_IMAGE=ghcr.io/haru-project/strawberry-ros-faces-module:feature-asr-improve

# LLM
HARU_LLM_IMAGE=ghcr.io/haru-project/haru-llm:feature-minimal_text_memory
ACTION_ARGS_CONFIG_FILE=/ros2_ws/src/haru-llm/configs/haru_llm.yaml
LLM_SERVER_BASE_URL=http://0.0.0.0:4050
VLLM_MODEL_NAME=openai/gpt-oss-20b
LANGFUSE_HOST=https://us.cloud.langfuse.com
WEBUI_AUTH=False
OPENAI_API_BASE_URL=${LLM_SERVER_BASE_URL}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard
HARU_AGENT_MODEL_ID=haru-local
HARU_JP_AGENT_MODEL_ID=haru-local
GOAL_AGENT_MODEL_ID=haru-local
GOAL_INFERENCE_AGENT_MODEL_ID=haru-local
GAZING_AGENT_MODEL_ID=haru-local
TTS_AGENT_MODEL_ID=haru-local
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=haru-local
SUMMARY_AGENT_MODEL_ID=haru-local
SYNCED_ROUTINES_AGENT_MODEL_ID=haru-local
MICRO_ROUTINES_AGENT_MODEL_ID=haru-local

# SPEECH
HARU_SPEECH_BASE_IMAGE=ghcr.io/haru-project/haru-speech-base:feature-asr-improve
HARU_SPEECH_AUDIO_IMAGE=ghcr.io/haru-project/haru-speech-audio:feature-asr-improve
HARU_SPEECH_RECOGNITION_IMAGE=ghcr.io/haru-project/haru-speech-recognition:feature-asr-improve
HARU_SPEECH_VERIFICATION_IMAGE=ghcr.io/haru-project/haru-speech-verification:feature-asr-improve
HARU_SPEECH_LOCALIZATION_IMAGE=ghcr.io/haru-project/haru-speech-localization:feature-asr-improve
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices
AUDIO_CONFIG_FILE=/shared/configs/haru_speech.yaml
AUDIO_CAPTURE_MODE=multi_device
AUDIO_CAPTURE_STATE_FILE=/shared/state/haru_speech/audio_capture_state.yaml
SPEECH_RECOGNITION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/shared/configs/haru_speech.yaml

# haru-viz bridge
HARU_ROSBRIDGE_DEPTH_TO_RGB_PORT=9093

# REASONER
REACTIVE_RULES_FILE=/shared/configs/reactiveness/reactive_rules.json
WORLD_MODEL_FILE=/shared/configs/world_models/haru_model.pddl
PLANSYS2_CONFIG_FILE=/shared/configs/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/shared/configs/params/postprocessors_params.yaml
TASK_SCENARIO_FILE=episodes/20260129.json
TASK_TEST_FILE=tests/Express.json

# SIMULATOR
AUDIO_CARD=0
PULSE_SERVER=unix:/tmp/pulse/native
PULSE_SOCKET_PATH=/run/user/1000/pulse/native

# TTS
PYTHONUNBUFFERED=1
