# Combined env file for docker-compose-all.yaml
# Keep in sync with envs/*.env when adding new compose-time variables.

# DISPLAY / GPU
DISPLAY=${DISPLAY:-=:0}
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS (default domain for most stacks)
ROS_DOMAIN_ID=35
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4 # set to UDPv4 if you encounter SHM issues

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# PERCEPTION
ROS_DATA=~/.ros

LEARNING_PERSON_NAME=Miguel    # the face will be registered as this name
LEARNING_PERSON_ID=2        # the person id to register (visible from RVIZ)
LEARNING_MODE=1
LEARNING_NUMBER_OF_SAMPLES=50

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# LLM
HARU_LLM_AGENTS_DIR=/shared/agents
HARU_LLM_DATA_DIR=/opt/ros/jazzy/workspace/install/share/haru_llm_ros/data
ACTION_ARGS_CONFIG_FILE=/shared/configs/haru_llm.yaml
DASHBOARD_CONFIG_FILE=/ros2_ws/src/haru-llm/configs/haru_llm.yaml
LLM_SERVER_BASE_URL=http://192.168.50.142:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8 # openai/gpt-oss-20b
LANGFUSE_HOST=https://us.cloud.langfuse.com
WEBUI_AUTH=False
OPENAI_API_BASE_URL=${LLM_SERVER_BASE_URL}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard
AGENTS_LOG_DIR=/ros2_ws/src/haru-llm/logs
HARU_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8 # gpt-oss-120b
HARU_JP_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8 # gpt-oss-120b
GOAL_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8 # gpt-oss-20b
GOAL_INFERENCE_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
GAZING_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
TTS_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
SUMMARY_AGENT_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8

# SPEECH
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices
AUDIO_CONFIG_FILE=/shared/configs/haru_speech.yaml
AUDIO_CONFIGURE_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEECH_RECOGNITION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
### CACHE DIR
HF_HOME=/shared/models/huggingface
TORCH_HOME=/shared/models/torch
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices

# REASONER
REACTIVE_RULES_FILE=/shared/configs/reactiveness/reactive_rules.json
WORLD_MODEL_FILE=/shared/configs/world_models/haru_model.pddl
PLANSYS2_CONFIG_FILE=/shared/configs/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/shared/configs/params/postprocessors_params.yaml
TASK_SCENARIO_FILE=episodes/20260129.json
TASK_TEST_FILE=tests/Express.json
#PLANSYS2_CONFIG_FILE=/shared/configs/plansys2_params.yaml
#POSTPROCESSORS_CONFIG_FILE=/shared/configs/postprocessors_params.yaml
##PLANSYS2_CONFIG_FILE=/ros2_ws/src/agent_reasoner/haru_agent_reasoner/params/plansys2_params.yaml
##POSTPROCESSORS_CONFIG_FILE=/ros2_ws/src/agent_reasoner/haru_agent_reasoner/params/postprocessors_params.yaml
#TASK_SCENARIO_FILE=episodes/20260129.json # builder/convo_with_free_talk.json

# SIMULATOR
AUDIO_CARD=0
PULSE_SERVER=unix:/tmp/pulse/native
PULSE_SOCKET_PATH=/run/user/1000/pulse/native

# TTS
PYTHONUNBUFFERED=1
