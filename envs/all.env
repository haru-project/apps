# Combined env file for docker-compose-all.yaml
# Keep in sync with envs/*.env when adding new compose-time variables.

# DISPLAY / GPU
DISPLAY=${DISPLAY:-=:0}
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS (default domain for most stacks)
ROS_DOMAIN_ID=22
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# LLM
ACTION_ARGS_CONFIG_FILE=/ros2_ws/src/haru-llm/configs/haru_llm.yaml
DASHBOARD_CONFIG_FILE=/ros2_ws/src/haru-llm/configs/haru_llm.yaml
LLM_SERVER_BASE_URL=http://0.0.0.0:4000
VLLM_MODEL_NAME=openai/gpt-oss-20b
LANGFUSE_HOST=https://us.cloud.langfuse.com
WEBUI_AUTH=False
OPENAI_API_BASE_URL=${LLM_SERVER_BASE_URL}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard
AGENTS_LOG_DIR=/ros2_ws/src/haru-llm/logs
HARU_AGENT_MODEL_ID=gpt-oss-120b
HARU_JP_AGENT_MODEL_ID=gpt-oss-120b
GOAL_AGENT_MODEL_ID=gpt-oss-20b
GOAL_INFERENCE_AGENT_MODEL_ID=gpt-oss-20b
GAZING_AGENT_MODEL_ID=gpt-oss-20b
TTS_AGENT_MODEL_ID=gpt-oss-20b
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=gpt-oss-20b

# SPEECH
AUDIO_CONFIG_FILE=/ros2_ws/src/haru-speech/configs/haru_speech.yaml
AUDIO_CONFIGURE_CONFIG_FILE=/ros2_ws/src/haru-speech/configs/haru_speech.yaml
SPEECH_RECOGNITION_CONFIG_FILE=/ros2_ws/src/haru-speech/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/ros2_ws/src/haru-speech/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/ros2_ws/src/haru-speech/configs/haru_speech.yaml

# REASONER
PLANSYS2_CONFIG_FILE=/ros2_ws/src/agent_reasoner/haru_agent_reasoner/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/ros2_ws/src/agent_reasoner/haru_agent_reasoner/params/postprocessors_params.yaml
TASK_SCENARIO_FILE=builder/convo_with_free_talk.json
TASK_TEST_FILE=tests/Express.json

# SIMULATOR
AUDIO_CARD=0

# TTS
PYTHONUNBUFFERED=1
