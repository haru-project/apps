# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# ROS
ROS_DOMAIN_ID=35
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4 # set to UDPv4 if you encounter SHM issues

# REASONER
REACTIVE_RULES_FILE=/shared/configs/reactiveness/reactive_rules.json
WORLD_MODEL_FILE=/shared/configs/world_models/haru_model.pddl
PLANSYS2_CONFIG_FILE=/shared/configs/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/shared/configs/params/postprocessors_params.yaml

# TASK
TASK_SCENARIO_FILE=episodes/20260129.json
TASK_TEST_FILE=tests/Express.json
