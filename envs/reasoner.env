# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# ROS
ROS_DOMAIN_ID=0

# Behavior-tree UI. Keep it opt-in for robot deployments; enabling Groot starts
# GUI monitors that can race the tree server during startup. Set this to true
# explicitly when the behavior-tree monitor is needed.
GROOT_MONITOR_ENABLED=false
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# REASONER
REACTIVE_RULES_FILE=/shared/configs/reactiveness/reactive_rules.json
WORLD_MODEL_FILE=/shared/configs/world_models/haru_model.pddl
PLANSYS2_CONFIG_FILE=/shared/configs/params/plansys2_params.yaml
POSTPROCESSORS_CONFIG_FILE=/shared/configs/params/postprocessors_params.yaml

# TASK
TASK_SCENARIO_FILE=episodes/20260527.json
TASK_TEST_FILE=tests/Conversate.json
