# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# CUDA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT # set to UDPv4 if you encounter SHM issues

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# CACHE DIR
HARU_LLM_AGENTS_DIR=/shared/agents
HARU_LLM_DATA_DIR=/opt/ros/jazzy/workspace/install/share/haru_llm_ros/data

# LLM
ACTION_ARGS_CONFIG_FILE=/shared/configs/haru_llm.yaml

# SERVER
LLM_SERVER_BASE_URL=http://0.0.0.0:4000
VLLM_MODEL_NAME=openai/gpt-oss-20b

# LANGFUSE (LLM Observability)
LANGFUSE_HOST=https://us.cloud.langfuse.com

# WEBUI
WEBUI_AUTH=False
OPENAI_API_BASE_URL=http://server:4000

# REDIS (Dashboard)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard

# AGENTS
HARU_AGENT_MODEL_ID=gpt-oss-120b-hf
HARU_JP_AGENT_MODEL_ID=gpt-oss-120b-hf
GOAL_AGENT_MODEL_ID=gpt-oss-20b-hf
GOAL_INFERENCE_AGENT_MODEL_ID=gpt-oss-20b-hf
GAZING_AGENT_MODEL_ID=gpt-oss-20b-hf
TTS_AGENT_MODEL_ID=gpt-oss-20b-hf
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=gpt-oss-20b-hf
