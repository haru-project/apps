# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# CUDA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT # set to UDPv4 if you encounter SHM issues

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3
# PACKAGE_VENV=/ros2_ws/src/haru-llm/.venv/bin/python3

# CACHE DIR
HARU_LLM_AGENTS_DIR=/shared/agents
HARU_LLM_DATA_DIR=/opt/ros/jazzy/workspace/install/share/haru_llm_ros/data
# HARU_LLM_DATA_DIR=/ros2_ws/src/haru-llm/data


# LLM
ACTION_ARGS_CONFIG_FILE=/shared/configs/haru_llm.yaml

# SERVER
LLM_SERVER_HOST_PORT=4050
LLM_SERVER_BASE_URL=http://127.0.0.1:4050/v1
BEDROCK_MANTLE_REGION=eu-central-1
VLLM_MODEL_NAME=openai/gpt-oss-20b

# WEBUI
WEBUI_AUTH=False
OPENAI_API_BASE_URL=http://server:4000/v1

# REDIS (Dashboard)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard

# AGENTS
HARU_AGENT_MODEL_ID=haru:canonical
HARU_JP_AGENT_MODEL_ID=haru:canonical
GOAL_AGENT_MODEL_ID=haru:canonical
GOAL_INFERENCE_AGENT_MODEL_ID=haru:canonical
GAZING_AGENT_MODEL_ID=haru:canonical
TTS_AGENT_MODEL_ID=haru:canonical
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=haru:canonical
SUMMARY_AGENT_MODEL_ID=haru:canonical
SYNCED_ROUTINES_AGENT_MODEL_ID=haru:canonical
MICRO_ROUTINES_AGENT_MODEL_ID=haru:canonical
