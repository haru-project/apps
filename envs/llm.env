# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# CUDA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS
ROS_DOMAIN_ID=12
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT # set to UDPv4 if you encounter SHM issues

# CACHE DIR
HARU_LLM_AGENTS_DIR=/shared/agents
HARU_LLM_DATA_DIR=/ros2_ws/src/haru-llm/data


# LLM
HARU_LLM_IMAGE=ghcr.io/haru-project/haru-llm:feature-minimal_text_memory
ACTION_ARGS_CONFIG_FILE=/shared/configs/haru_llm.yaml

# SERVER
LLM_SERVER_BASE_URL=http://0.0.0.0:4050
VLLM_MODEL_NAME=openai/gpt-oss-20b

# LANGFUSE (LLM Observability)
LANGFUSE_HOST=https://us.cloud.langfuse.com

# WEBUI
WEBUI_AUTH=False
OPENAI_API_BASE_URL=http://server:4000

# REDIS (Dashboard)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=haru_llm_dashboard

# AGENTS
HARU_AGENT_MODEL_ID=haru-local
HARU_JP_AGENT_MODEL_ID=haru-local
GOAL_AGENT_MODEL_ID=haru-local
GOAL_INFERENCE_AGENT_MODEL_ID=haru-local
GAZING_AGENT_MODEL_ID=haru-local
TTS_AGENT_MODEL_ID=haru-local
EXPRESSIVE_BEHAVIOR_AGENT_MODEL_ID=haru-local
SUMMARY_AGENT_MODEL_ID=haru-local
SYNCED_ROUTINES_AGENT_MODEL_ID=haru-local
MICRO_ROUTINES_AGENT_MODEL_ID=haru-local
