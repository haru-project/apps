HARU_SPEECH_AUDIO_IMAGE=ghcr.io/haru-project/haru-speech-audio:feature-perception-attention
HARU_SPEECH_RECOGNITION_IMAGE=ghcr.io/haru-project/haru-speech-recognition:feature-perception-attention
HARU_SPEECH_VERIFICATION_IMAGE=ghcr.io/haru-project/haru-speech-verification:feature-perception-attention
