# ROS
ROS_DOMAIN_ID=0
HARU_PERCEPTION_ROS_DOMAIN_ID=20
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT

# Recorder image
HARU_RECORDER_IMAGE=ghcr.io/haru-project/haru-recorder:feature-skeleton-integration

# Recorder + UI
# Keep this at package default unless you provide your own config in
# ../data/perception/haru_recorder/config/default_params.yaml.
RECORDER_CONFIG_FILE=/opt/ros/jazzy/workspace/install/share/haru_recorder/config/default_params.yaml
HARU_RECORDER_WEB_UI_PORT=8088
HARU_RECORDER_SESSION_ID=

# Optional cloud upload settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_ENDPOINT_URL=
