# Copy this file to envs/llm.secrets.env and populate only the providers you use.
# envs/llm.secrets.env is ignored by Git and must never be committed.

# SERVER (secrets)
LLM_SERVER_API_KEY=

# API KEYS
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
# Required by the tracked haru:canonical Bedrock Mantle model mapping.
# Older deployments called this BEDROCK_API_KEY; rename that variable when
# migrating an existing secrets file.
BEDROCK_MANTLE_API_KEY=
# Used only when setup selects a custom OpenAI-compatible endpoint
CUSTOM_LLM_API_KEY=

# LANGFUSE (LLM Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
