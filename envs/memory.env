# ROS
# `envs/all.env` may override this when the memory services are included in the
# all-in-one stack.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Agent Memory
AGENT_MEMORY_CONFIG_FILE=/shared/configs/agent_memory.yaml
AGENT_MEMORY_WEAVIATE_HTTP_PORT=8082
AGENT_MEMORY_WEAVIATE_GRPC_PORT=50052
AGENT_MEMORY_DASHBOARD_PORT=8502
AGENT_MEMORY_T2V_ENABLE_CUDA=0
