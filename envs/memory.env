# ROS
# `envs/all.env` may override this when the memory services are included in the
# all-in-one stack.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Agent Memory
AGENT_MEMORY_CONFIG_FILE=/shared/configs/agent_memory.yaml

# Which LLM runs agent-memory's summaries, importance scoring and fact extraction.
#   litellm — the shared LiteLLM proxy the other agents already use (haru:canonical).
#             The bundled Ollama container is left out of the stack entirely, so it claims
#             no GPU memory. Requires the llm stack to be up: agent-memory does not queue
#             work while the proxy is unreachable, so a session closed during an outage
#             loses its facts. start.sh already starts llm before memory.
#   ollama  — the bundled agent-memory-ollama container: local, private, no API cost and
#             no dependency on the llm stack, but it holds ~4.3 GB of GPU memory.
# Changing this takes effect on the next `compose.sh memory up -d`; nothing else needs editing.
AGENT_MEMORY_LLM_BACKEND=litellm

# Active when AGENT_MEMORY_LLM_BACKEND=litellm.
# Targets the host-networked OpenAI-compatible proxy endpoint (LLM_SERVER_HOST_PORT from envs/llm.env).
AGENT_MEMORY_LITELLM_URL=http://127.0.0.1:4050/v1
AGENT_MEMORY_LITELLM_MODEL=haru:canonical
AGENT_MEMORY_WEAVIATE_HTTP_PORT=8082
AGENT_MEMORY_WEAVIATE_GRPC_PORT=50052
AGENT_MEMORY_DASHBOARD_PORT=8502
AGENT_MEMORY_T2V_ENABLE_CUDA=0
