# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# CUDA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS
ROS_DOMAIN_ID=20
HARU_PERCEPTION_ROS_DOMAIN_ID=20
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT # set to UDPv4 if you encounter SHM issues

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# CACHE DIR
HF_HOME=/shared/models/huggingface
TORCH_HOME=/shared/models/torch
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices

# SPEECH
HARU_SPEECH_BASE_IMAGE=ghcr.io/haru-project/haru-speech-base:feature-asr-improve
HARU_SPEECH_AUDIO_IMAGE=ghcr.io/haru-project/haru-speech-audio:feature-asr-improve
HARU_SPEECH_RECOGNITION_IMAGE=ghcr.io/haru-project/haru-speech-recognition:feature-asr-improve
HARU_SPEECH_VERIFICATION_IMAGE=ghcr.io/haru-project/haru-speech-verification:feature-asr-improve
HARU_SPEECH_LOCALIZATION_IMAGE=ghcr.io/haru-project/haru-speech-localization:feature-asr-improve
AUDIO_CONFIG_FILE=/shared/configs/haru_speech.yaml
AUDIO_CAPTURE_MODE=multi_device
SPEECH_RECOGNITION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
