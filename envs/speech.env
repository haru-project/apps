# DISPLAY
DISPLAY=${DISPLAY:-=:0}

# CUDA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ROS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# PYTHON VENV
PACKAGE_VENV=/opt/ros/jazzy/workspace/package_venv/bin/python3

# CACHE DIR
HF_HOME=/shared/models/huggingface
TORCH_HOME=/shared/models/torch
HARU_SPEECH_MODELS_DIR=/shared/models
HARU_SPEECH_VOICES_DIR=/shared/voices

# SPEECH
AUDIO_CONFIG_FILE=/shared/configs/haru_speech.yaml
AUDIO_CONFIGURE_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEECH_RECOGNITION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SPEAKER_VERIFICATION_CONFIG_FILE=/shared/configs/haru_speech.yaml
SOUND_LOCALIZATION_CONFIG_FILE=/shared/configs/haru_speech.yaml